# Copy this file to .env and edit the values.

# ----- Profile -----
# Path to the canonical profile file (YAML). The agent loads this to fill forms.
JOB_AGENT_PROFILE=profile.yaml

# Optional: path to your resume file (PDF). Uploaded to job applications.
JOB_AGENT_RESUME=resume.pdf

# ----- Tracker -----
# SQLite database path used to record which jobs have been seen / applied / skipped.
JOB_AGENT_DB=applications.db

# ----- Run mode -----
# "dry_run" fills forms but does NOT click submit (safe default).
# "submit" actually submits applications.
JOB_AGENT_MODE=dry_run

# ----- Job source config -----
# Comma-separated list of company slugs to search on each board.
# Example: GREENHOUSE_BOARDS=stripe,airbnb,figma
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=

# ----- LLM (the 1%) -----
# Provider: "ollama" (default, local), "openai", or "anthropic".
JOB_AGENT_LLM_PROVIDER=ollama

# Ollama config (used when provider=ollama)
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.2

# OpenAI config (used when provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic config (used when provider=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
